{
  "name": "patchsentry-web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "agent": "node scripts/agent.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@aws-sdk/client-device-farm": "3.1160.0",
    "@better-auth/core": "1.7.14",
    "@vercel/sandbox": "3.9.1",
    "better-auth": "1.7.14",
    "better-call": "1.4.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jose": "6.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
