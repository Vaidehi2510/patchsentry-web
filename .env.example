# Production: attach a persistent PostgreSQL database. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_URL=https://YOUR-SITE.vercel.app
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Verified email-link sign-in. Use a dedicated Gmail sender with 2-Step
# Verification and a Google app password (not your ordinary account password).
# Set these as server-only Production variables in Vercel; never NEXT_PUBLIC_*.
SMTP_USER=your-patchsentry-sender@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD

# For local development instead of DATABASE_URL:
# PGLITE_DATA_DIR=.local/database
# BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Provider keys belong on the QA runner, not in this website environment.
